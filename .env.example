# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./stock_tracker.db

# ── Watchlist ─────────────────────────────────────────────────────────────────
# Comma-separated. SPY and QQQ are always added as regime instruments.
# NVDA/TSLA  → high-beta large-caps (expensive per share, high volatility)
# PLTR       → Palantir ~$35-40, AI/data, high RVOL, great for day trading
# HOOD       → Robinhood ~$45-55, volatile fintech, strong intraday moves
# SOFI       → SoFi ~$15-18, fast-moving fintech, cheaper per share
WATCHLIST=SPY,QQQ,NVDA,TSLA,PLTR,HOOD,SOFI

# ── Alpaca credentials (leave blank to run in mock/synthetic mode) ─────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Paper trading base URL (default). Change to https://api.alpaca.markets for live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# iex = free real-time data  |  sip = full SIP tape (paid subscription required)
ALPACA_DATA_FEED=iex

# ── Execution ─────────────────────────────────────────────────────────────────
# Options:
#   paper_local   → simulated fills, local DB only (safe for testing)
#   paper_alpaca  → real Alpaca paper-trading API (requires credentials below)
#   live          → REAL MONEY orders via Alpaca — requires LIVE_TRADING_ENABLED=true
#
# TO CONNECT YOUR REAL ALPACA ACCOUNT:
#   1. Sign up at https://alpaca.markets and fund your account
#   2. Go to Paper Trading → then switch to Live Trading in the Alpaca dashboard
#   3. Generate a Live API key (NOT the paper-trading key)
#   4. Paste your live key/secret in ALPACA_API_KEY / ALPACA_API_SECRET below
#   5. Set ALPACA_BASE_URL=https://api.alpaca.markets  (live endpoint)
#   6. Set EXECUTION_MODE=live and LIVE_TRADING_ENABLED=true
#   7. Restart the app — the bot will now submit real orders
#
EXECUTION_MODE=paper_local
AUTO_PAPER_EXECUTION=false
KILL_SWITCH_DEFAULT=false
LIVE_TRADING_ENABLED=false

# ── Signal thresholds ─────────────────────────────────────────────────────────
SIGNAL_SCORE_FLASH_THRESHOLD=85
SIGNAL_SCORE_TRADE_THRESHOLD=70
SIGNAL_SCORE_WATCH_THRESHOLD=55

# ── Scoring weights (must total 100) ─────────────────────────────────────────
WEIGHT_TECHNICAL_TREND=25
WEIGHT_CANDLESTICK=20
WEIGHT_VOLUME=15
WEIGHT_VWAP=15
WEIGHT_MARKET_REGIME=10
WEIGHT_NEWS=15

# ── Risk management ───────────────────────────────────────────────────────────
MAX_TRADES_PER_DAY=2
DAILY_LOSS_LIMIT=500.0
PER_TRADE_RISK_PCT=1.0
DEFAULT_CAPITAL=10000.0
SYMBOL_COOLDOWN_MINUTES=30
EOD_FLATTEN_MINUTES=10

# ── Session / Market hours ────────────────────────────────────────────────────
SESSION_TIMEZONE=America/New_York
MARKET_OPEN_TIME=09:30
MARKET_CLOSE_TIME=16:00
PREMARKET_START_TIME=04:00
AFTERHOURS_END_TIME=20:00
PREMARKET_ENABLED=true
OPENING_RANGE_MINUTES=15

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_COOLDOWN_SECONDS=300

# Telegram (optional): create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional): Server → Edit Channel → Integrations → Create Webhook
DISCORD_WEBHOOK_URL=

# ── News ──────────────────────────────────────────────────────────────────────
NEWS_MAX_AGE_HOURS=8

# ── LLM news summarisation (optional, disabled by default) ────────────────────
USE_LLM_NEWS_SUMMARY=false
LLM_PROVIDER=anthropic
LLM_API_KEY=

# ── Scoring interval ──────────────────────────────────────────────────────────
SCORE_INTERVAL_SECONDS=30

# ── Bar history ───────────────────────────────────────────────────────────────
BAR_HISTORY_DAYS=5
MAX_BARS_1M=390
MAX_BARS_5M=150
MAX_BARS_15M=60
